<?xml version="1.0" encoding="utf-8"?>
<!-- Test viewer for the CAD core. It uses the Android platform APIs only
     and asks for no permissions: files come through the system file picker
     or "Open with", which grant access to that one file. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="CAD Viewer"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- configChanges: rotating or resizing keeps the open drawing
             instead of restarting the screen. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTop">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with": DWG under the MIME types in common use, and
                 untyped files, which is how .cad files arrive. The app
                 checks the contents, not the name. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="image/vnd.dwg" />
                <data android:mimeType="image/x-dwg" />
                <data android:mimeType="application/acad" />
                <data android:mimeType="application/x-acad" />
                <data android:mimeType="application/dwg" />
                <data android:mimeType="application/x-dwg" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
    </application>
</manifest>
